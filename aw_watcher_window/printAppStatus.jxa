#!/usr/bin/osascript -l JavaScript

// adapted from:
// https://gist.github.com/EvanLovely/cb01eafb0d61515c835ecd56f6ac199a

// new to jxa?
// - https://apple-dev.groups.io/g/jxa/wiki/3202
// - interactive repl: `osascript -il JavaScript`
// - API reference: Script Editor -> File -> Open Dictionary

var seApp         = Application("System Events");
var oProcess      = seApp.processes.whose({frontmost: true})[0];
var appName       = oProcess.displayedName();

// as of 05/01/21 incognio & url are not actively used in AW
// variables must be set to `undefined` since this script is re-run via osascript
// and the previously set values will be cached otherwise
var url = undefined, incognito = undefined, title = undefined;

// Reported when the frontmost app has no window we can inspect. Some apps are
// not scriptable via JXA at all, and some scriptable apps are open with no
// window (or only a devtools window). An uncaught throw here aborts the whole
// poll, so every window lookup below is guarded and falls back to this value.
var NO_WINDOW_TITLE = "No window";

// Best-effort title of the frontmost app's main window, read through the
// Accessibility API (which also works for apps that don't support JXA
// scripting). Returns undefined when no window title can be read.
function axWindowTitle(proc) {
  try {
    var mainWindow = proc.windows().find(function(w) {
      try {
        return w.attributes.byName("AXMain").value() === true;
      } catch (e) {
        return false;
      }
    });
    if (mainWindow) {
      return mainWindow.attributes.byName("AXTitle").value();
    }
  } catch (e) {
    // The app exposes no scriptable windows.
  }
  try {
    // No window is flagged as AXMain (e.g. a dialog); take the first one.
    return proc.windows()[0].attributes.byName("AXTitle").value();
  } catch (e) {
    return undefined;
  }
}

// WhatsApp exposes the selected chat as a heading rather than its window title.
// This still traverses the whole AX tree; native polling-cost verification is
// required before shipping it. Return undefined to reuse the normal fallback.
function whatsAppChatTitle(proc) {
  try {
    var mainWindow = proc.windows().find(function(w) {
      try {
        return w.attributes.byName("AXMain").value() === true;
      } catch (e) {
        return false;
      }
    });
    if (mainWindow) {
      var elements = mainWindow.entireContents();
      for (var i = 0; i < elements.length; i++) {
        try {
          var attributes = elements[i].attributes;
          if (attributes.byName("AXRole").value() === "AXHeading" &&
              attributes.byName("AXIdentifier").value() === "NavigationBar_HeaderViewButton") {
            var chatName = attributes.byName("AXDescription").value();
            if (typeof chatName === "string" && chatName.length > 0) {
              return chatName;
            }
          }
        } catch (e) {
          // A disappearing or inaccessible element must not abort this poll.
        }
      }
    }
  } catch (e) {
    // The AX tree may be unavailable while WhatsApp changes windows.
  }
  return undefined;
}

// it's not possible to get the URL from firefox
// https://stackoverflow.com/questions/17846948/does-firefox-offer-applescript-support-to-get-url-of-windows

switch(appName) {
  case "Safari":
    // incognito is not available via safari applescript
    try {
      url = Application(appName).documents[0].url();
      title = Application(appName).documents[0].name();
    } catch (e) {
      // Discard partial browser reads before using an Accessibility title.
      url = undefined;
      incognito = undefined;
      // Safari can be open with no document (no window, or devtools only).
      title = axWindowTitle(oProcess);
    }
    break;
  case "Google Chrome":
  case "Google Chrome Canary":
  case "Chromium":
  case "Brave Browser":
    try {
      var activeWindow = Application(appName).windows[0];
      var activeTab = activeWindow.activeTab();

      url = activeTab.url();
      title = activeTab.name();
      incognito = activeWindow.mode() === 'incognito';
    } catch (e) {
      // Discard partial browser reads before using an Accessibility title.
      url = undefined;
      incognito = undefined;
      // The browser can be open with no window.
      title = axWindowTitle(oProcess);
    }
    break;
  case "Firefox":
  case "Firefox Developer Edition":
    try {
      title = Application(appName).windows[0].name();
    } catch (e) {
      title = axWindowTitle(oProcess);
    }
    break;
  default:
    if (appName.indexOf("WhatsApp") !== -1) {
      title = whatsAppChatTitle(oProcess);
    }
    if (title === undefined) {
      title = axWindowTitle(oProcess);
    }
}

// The Python side requires a title key (it indexes current_window["title"]),
// so never leave it undefined.
if (title === undefined) {
  title = NO_WINDOW_TITLE;
}

// key names must match expected names in lib.py
JSON.stringify({
  app: appName,
  url,
  title,
  incognito
});
